# OmniBot - Discord Token
DISCORD_TOKEN=tu_token_aqui

# OpenRouter API (para el cerebro del bot)
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Lavalink
LAVALINK_PASSWORD=your_password_here

# YouTube OAuth (obtener del log de Lavalink al iniciar)
YOUTUBE_OAUTH_REFRESH_TOKEN=

# Deezer (obtener ARL desde F12 > Cookies > deezer.com)
DEEZER_ARL=
# Clave estática pública de Deezer (requerida por LavaSrc); se inyecta por env
DEEZER_MASTER_KEY=

# Base de datos (ruta persistente; en Dokploy montar un volumen en esta carpeta)
OMNIBOT_DB_DIR=/app/data

# Endpoint de estado (/api/status). Si está vacío, el endpoint responde 404.
# Generate con: openssl rand -hex 24
STATUS_API_TOKEN=

# Auto-Radio (canal de voz fijo de la radio 24/7; 0 = desactivada)
AUTORADIO_CHANNEL_ID=0
AUTORADIO_STATION=rock

# Memes (pool de subreddits y horas de publicación)
# Pool por defecto: memes generales. Configúralo según tu comunidad.
MEME_SUBREDDITS=memes,dankmemes,me_irl,gaming
MEME_HOURS=10,18
# Días temáticos (día_semana:tema, 0=lunes): gaming, dark, futbol
MEME_THEME_DAYS=0:gaming,2:dark,4:futbol
# Zona horaria para el horario de memes (IANA, ej: America/Argentina/Buenos_Aires)
MEME_TIMEZONE=America/Argentina/Buenos_Aires

# Reddit OAuth (OPCIONAL - requiere aprobación manual de Reddit)
# Sin credenciales, el bot usa el RSS público de Reddit (top del día)
# Si tenés una app aprobada: https://www.reddit.com/prefs/apps (tipo: script)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Auto-mod extra
# Palabras adicionales al filtro (separadas por coma)
BANNED_WORDS=
# 1 = bloqueo automático de canales al detectar raid | 0 = solo alerta
RAID_AUTO_LOCKDOWN=1
# Edad mínima de cuenta para no marcar como sospechosa (días)
MIN_ACCOUNT_AGE_DAYS=7

# Backups automáticos de la base de datos (días de retención)
BACKUP_RETENTION_DAYS=7
